# Python / Envs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env
.venv
.conda/
Anaconda3/
anaconda_projects/

# Pacotes
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Jupyter
.ipynb_checkpoints

# VSCode / IDEs
.vscode/
.idea/
*.swp
*.swo

# Ignorar ZIPs temporários
*.zip
*.tar.gz
*.rar

# IMPORTANTE: Pastas gigantes (> 2.3GB de dados e binários) que fazer o push travar no GitHub
data/*
!data/.gitkeep
models/*
!models/.gitkeep
logs/
!logs/.gitkeep

# Local archive of legacy/reference material (large notebooks with embedded
# outputs) -- kept on disk for the user's own reference, not pushed to git.
archive/

# Third-party reference material for the thesis (USP/Esalq manual, template and
# example documents), kept locally and not redistributed.
docs/thesis/reference/
